{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "foods"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "nutrients",
          "sources",
          "portions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "g",
              "ml"
            ]
          },
          "nutrients": {
            "type": "object"
          },
          "sources": {
            "type": "array",
            "minItems": 1
          },
          "portions": {
            "type": "array"
          },
          "category_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "categories"
        ]
      },
      "then": {
        "properties": {
          "foods": {
            "items": {
              "required": [
                "category_id"
              ]
            }
          }
        }
      }
    }
  ]
}
