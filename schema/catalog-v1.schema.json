{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "foods"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "nutrients",
          "sources",
          "portions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "g",
              "ml"
            ]
          },
          "nutrients": {
            "type": "object"
          },
          "sources": {
            "type": "array",
            "minItems": 1
          },
          "portions": {
            "type": "array"
          }
        }
      }
    }
  }
}